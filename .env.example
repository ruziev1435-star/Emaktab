# Copy to .env and fill in for local/deploy config. Nothing here is required
# for the demo — sensible defaults are used when a variable is unset.

# Postgres/MySQL connection string; unset = local SQLite file (db.sqlite3).
# DATABASE_URL=postgres://user:password@host:5432/kundalikplus

# Telegram bot token from @BotFather; unset = outbound Telegram sends are
# skipped and just logged to NotificationLog instead.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_BOT_USERNAME=KundalikPlusBot
