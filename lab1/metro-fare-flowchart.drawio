        <mxCell id="boxC" value="total += 20 &#215; 20&#10;r = r &#8722; 20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="770" width="280" height="55" as="geometry" />
