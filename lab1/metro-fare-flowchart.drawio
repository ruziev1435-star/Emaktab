<mxfile host="app.diagrams.net" agent="lab1" version="24.0.0">
  <diagram name="Metro Fare Flowchart" id="metro-fare-flowchart">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
