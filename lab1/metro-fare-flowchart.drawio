        <mxCell id="r2c1" value="30 &#215; 2100 = 63,000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=11;spacing=6;" vertex="1" parent="1">
