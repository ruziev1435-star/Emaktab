        <mxCell id="r1c3" value="within budget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e2f1e9;strokeColor=#82b366;fontSize=12;fontStyle=1;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="710" y="948" width="170" height="58" as="geometry" />
