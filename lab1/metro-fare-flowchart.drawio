<mxfile host="app.diagrams.net" agent="lab1" version="24.0.0">
  <diagram name="Metro Fare Flowchart" id="metro-fare-flowchart">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Metro fare — how I worked it out" style="text;html=1;align=left;valign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Fare tiers I used: rides 1&#8211;10 &#8594; 25 som each, 11&#8211;30 &#8594; 20 som each, 31+ &#8594; 15 som each. (Swap in the real numbers if the instructor gave different ones.)" style="text;html=1;align=left;valign=middle;fontSize=11;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="860" height="34" as="geometry" />
        </mxCell>

        <mxCell id="start" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;where the calc begins&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="95" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="input" value="&lt;b&gt;Input: rides&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;ask how many trips they bought&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="175" width="200" height="58" as="geometry" />
        </mxCell>

        <mxCell id="init" value="&lt;b&gt;total = 0;  r = rides&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;nothing charged yet &#8212; r tracks what's left to price&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="258" width="300" height="62" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;r &#8804; 10 ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;did they buy 10 trips or fewer?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="345" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="boxA" value="&lt;b&gt;total += 10&#215;25;  r -= 10&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;charge the first 10 at full price, then keep going&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="535" width="300" height="62" as="geometry" />
        </mxCell>

        <mxCell id="boxB" value="&lt;b&gt;total += r&#215;25 &#8212; done&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;10 or fewer: everything's full price&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="385" width="200" height="66" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="&lt;b&gt;r &#8804; 20 ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;does the rest fit in the next 20 trips?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="617" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="boxE" value="&lt;b&gt;total += r&#215;20 &#8212; done&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;the rest fits the middle tier&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="657" width="200" height="66" as="geometry" />
        </mxCell>

        <mxCell id="boxC" value="&lt;b&gt;total += 20&#215;20;  r -= 20&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;charge the whole middle tier, then keep going&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="807" width="300" height="58" as="geometry" />
        </mxCell>

        <mxCell id="boxD" value="&lt;b&gt;total += r&#215;15&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555555;&quot;&gt;whatever's left is the cheapest rate &#8212; no more tiers&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="880" width="260" height="58" as="geometry" />
        </mxCell>

        <mxCell id="output" value="&lt;b&gt;Output total&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#2c6e3f;&quot;&gt;hand the rider their total&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="270" y="963" width="220" height="58" as="geometry" />
        </mxCell>

        <mxCell id="end" value="&lt;b&gt;End&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;fare's ready to show&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="1046" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="input">
