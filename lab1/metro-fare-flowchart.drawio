        <mxCell id="d2" value="r &#8804; 20 ?&#10;(second tier)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="610" width="240" height="110" as="geometry" />
